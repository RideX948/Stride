# Copy this file to .env and fill in your values.

# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Prefer the "Transaction pooler" string (port 6543) — works on all networks.
# Example:
# DATABASE_URL=postgresql://postgres.abcdefghijkl:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Session cookie signing secret (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed browser origins in production (e.g. https://your-app.com,http://localhost:8081)
# Leave empty to allow all origins in production (not recommended).
CORS_ORIGINS=

# In production, set to false so unverified drivers cannot go online
# AUTO_VERIFY_DRIVERS=true

# ── SMS (OTP) ───────────────────────────────────────────────────────────────
# Leave SMS_PROVIDER empty for dev mode: OTP is logged and returned as devCode.
# Ghana: arkesel | hubtel   Global: twilio
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=RideX
# Hubtel only:
SMS_CLIENT_ID=
# Twilio only:
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=

# App identifier embedded in session JWTs (required for session verification)
VITE_APP_ID=ridex

# ── Aza payments (api.aza.systems) ──────────────────────────────────────────
# Leave AZA_API_KEY empty for dev mode: top-ups auto-complete after ~2s and
# payouts succeed instantly, all simulated — no merchant account needed.
# To go live: complete KYB at merchants.aza.systems, create a key (aza_test_
# behaves identically to aza_live_ but moves no real money), then register the
# webhook with:  npx tsx scripts/register-aza-webhook.ts https://your-host
# (locally: npx ngrok http 3000 for a public URL) and set the printed secret.
AZA_API_KEY=
AZA_WEBHOOK_SECRET=
# AZA_API_URL=https://api.aza.systems
